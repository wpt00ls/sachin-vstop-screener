#!/bin/bash

# Navigate to the project root (one level up from .bin)
cd "$(dirname "$0")/.." || exit

ARCHIVE_NAME="vstop_screener_package.zip"

echo "Packaging files into $ARCHIVE_NAME..."

# Ensure results directory exists to include it even if empty
mkdir -p results

# Create the zip archive with the requested files and results folder
zip -r "$ARCHIVE_NAME" \
    vstop_screener.py \
    requirements.txt \
    backtester.py \
    results/

if [ $? -eq 0 ]; then
    echo -e "\n✅ Successfully packaged into $(pwd)/$ARCHIVE_NAME"
else
    echo -e "\n❌ Error: Failed to package files."
    exit 1
fi
